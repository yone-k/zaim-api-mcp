  {
    "name": "zaim_bulk_create_payments",
    "description": "Zaimに複数の支出記録を一括作成します（最大100件）。記録を順番に1回ずつ送信し、失敗した記録があっても残りを続行して、記録ごとの結果を返します。",
    "inputSchema": {
      "type": "object",
      "properties": {
        "items": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "description": "作成する支出記録の配列（各要素はzaim_create_paymentと同じ引数）",
          "items": {
            "type": "object",
            "properties": {
              "amount": {
                "type": "number",
                "description": "金額",
                "exclusiveMinimum": 0
              },
              "date": {
                "type": "string",
                "description": "日付（YYYY-MM-DD形式）"
              },
              "category_id": {
                "type": "number",
                "description": "カテゴリID"
              },
              "genre_id": {
                "type": "number",
                "description": "ジャンルID"
              },
              "from_account_id": {
                "type": "number",
                "description": "出金元口座ID"
              },
              "place": {
                "type": "string",
                "description": "場所・店舗名"
              },
              "comment": {
                "type": "string",
                "description": "メモ"
              },
              "name": {
                "type": "string",
                "description": "品名"
              }
            },
            "required": [
              "amount",
              "date",
              "category_id",
              "genre_id"
            ],
            "additionalProperties": false
          }
        },
        "dry_run": {
          "type": "boolean",
          "default": false,
          "description": "trueの場合はAPIを呼び出さずに検証のみ行う"
        }
      },
      "required": [
        "items"
      ],
      "additionalProperties": false
    }
  },

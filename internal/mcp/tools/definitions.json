        },
        "category_id": {
          "type": "number",
          "description": "カテゴリID"
        },
        "to_account_id": {
          "type": "number",
          "description": "入金先口座ID"
        },
        "place": {
          "type": "string",
          "description": "場所・会社名"
        },
        "comment": {
          "type": "string",
          "description": "メモ"
        }
      },
      "required": [
        "amount",
        "date",
        "category_id"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "zaim_create_transfer",
    "description": "Zaimに振替記録を作成します（口座間の資金移動）",
